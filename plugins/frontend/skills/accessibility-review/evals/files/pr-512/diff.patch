new file mode 100644
index 0000000..3f1c2a7
--- /dev/null
+++ b/src/components/SortMenu.tsx
@@ -0,0 +1,34 @@
+import { useState } from 'react';
+import { ChevronIcon } from './icons';
+
+const OPTIONS = ['Relevance', 'Price: low to high', 'Price: high to low', 'Newest'];
+
+export function SortMenu({ value, onChange }: { value: string; onChange: (v: string) => void }) {
+  const [open, setOpen] = useState(false);
+
+  return (
+    <div className="sort-menu">
+      <div className="sort-trigger" onClick={() => setOpen(!open)}>
+        Sort: {value} <ChevronIcon />
+      </div>
+      {open && (
+        <ul className="sort-options">
+          {OPTIONS.map((option) => (
+            <li
+              key={option}
+              className={option === value ? 'sort-option selected' : 'sort-option'}
+              onClick={() => {
+                onChange(option);
+                setOpen(false);
+              }}
+            >
+              {option}
+            </li>
+          ))}
+        </ul>
+      )}
+    </div>
+  );
+}
+
+export default SortMenu;
